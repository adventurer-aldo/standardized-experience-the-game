[node name="Quote" type="Label" parent="QuoteBG/QuoteContainer" unique_id=562358169]
custom_minimum_size = Vector2(1.545, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.19607843, 0.1882353, 0.23137255, 1)
theme_override_colors/font_outline_color = Color(0.19607843, 0.1882353, 0.23137255, 1)
theme_override_constants/outline_size = 1
theme_override_fonts/font = ExtResource("4_u15dr")
theme_override_font_sizes/font_size = 45
text = "\"We're unprepared for every challenge we meet for the first time.\""
vertical_alignment = 1
autowrap_mode = 2
script = ExtResource("4_55s3s")
quotes = PackedStringArray("We\'re unprepared for every challenge we meet for the first time.", "The early student learns sooner.", "Each defeat is a step towards the ending.", "Don\'t wait for the challenge to get prepared for it.", "To err is to gain experience.", "With new knowledge, you don\'t study how you came to know it.", "Your own experienced knowledge is more valuable than words of others.", "Pacience and persistence are needed to create a solid mind.", "Learning is simple. We make it difficult.", "Incompetence is a feeling that can never be experienced again once you gain mastery.", "Humans are beings of knowledge and experience.", "To study is to train the mind.", "Experience is a cruel teacher. She gives the test first and the lesson afterwards.", "Being ready enough is a myth, even for the truly experienced.", "Self-esteem is irrelevant for whether you do good or bad.", "Being a genius is subjective to others\' intellect. Evolution is subjective to the growth between you and your past.", "If you\'re not leveling up, you\'re leveling down.", "Courage and bravery triumph over confidence when learning.", "You don\'t lack willpower—you lack a compelling enough reason.", "Talent is just early progress that you mistook for destiny.", "Being busy is a decision, not a circumstance.", "Overthinking is just underdoing disguised as preparation.", "Procrastination isn\'t laziness—it\'s perfectionism wearing a disguise.", "Suffering doesn\'t build character—how you interpret suffering does.", "Clarity comes from action, not contemplation.", "You don\'t struggle with the subject—you struggle with the fact that struggling is part of the subject.", "Every time you say \'I\'ll understand it later,\' you\'re choosing to misunderstand it now.", "The difference between an A and a C isn\'t intelligence. It\'s whether you started the problem set on Tuesday or Sunday.", "Cramming proves you could have learned it slowly if you\'d wanted to. You just chose panic over preparation.", "The material didn\'t get harder. You just got further behind.", "You don\'t \'not get it\'—you just haven\'t gotten it yet, and you\'re pretending that\'s permanent.", "Intelligence is what you use to avoid the work that would make you competent.", "Intelligence is subjective. Competence is not.", "Complete mastery of a challenging subject begins with reading a single sentence.", "Those who never venture outside their comfort zone never learn their ability to master skills beyond it.", "Even dust, when piled up, becomes a mountain.", "Study the old to know the new.", "Fail seven times, retry eight.", "After rain, the ground hardens.", "Only failure cures stupidity.", "Even monkeys fall from trees sometimes.", "Adversity strengthens the foundations of your knowledge.", "The more people you have, the more ideas you will get through the discussion.", "One who chases after 2 rabbits will not even catch one.", "One man’s failure is another’s lesson.", "Giving birth is easier than worrying about it.")

